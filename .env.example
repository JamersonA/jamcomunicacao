# URL pública do site (canônica, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://jamcomunicacao.com.br

# Base dos vídeos (sem barra no fim). O site busca `${NEXT_PUBLIC_VIDEO_BASE}/<slug>.mp4`.
# Sem a variável, usa /media/videos (só local: a pasta não vai para o git).
NEXT_PUBLIC_VIDEO_BASE=https://jam-videos.comunicacaosite-jam.workers.dev
