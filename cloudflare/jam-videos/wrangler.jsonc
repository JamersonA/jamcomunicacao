{
  // Worker dos vídeos do site: https://jam-videos.comunicacaosite-jam.workers.dev
  // Publicar (da raiz do projeto): npx wrangler deploy --config cloudflare/jam-videos/wrangler.jsonc
  "name": "jam-videos",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../public/media/videos",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
